# Backend API Base URL
# Local Development: http://localhost:5000
# Production (Render Web Service): https://nutrilens-api.onrender.com (replace with your actual Render URL)
NEXT_PUBLIC_API_URL=http://localhost:5000

# Show one-click demo login buttons (user + admin) on the login page.
# Only for showcase deployments; the API must also run with DEMO_MODE=true.
NEXT_PUBLIC_DEMO_MODE=false
