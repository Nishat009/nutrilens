# Backend API Base URL
# Local Development: http://localhost:5000
# Production (Render Web Service): https://nutrilens-api.onrender.com (replace with your actual Render URL)
NEXT_PUBLIC_API_URL=http://localhost:5000

# Show the one-click demo login buttons on /login (set to false when the API runs with DEMO_MODE=false)
NEXT_PUBLIC_DEMO_MODE=true
# Must match DEMO_MEMBER_PASSWORD / DEMO_ADMIN_PASSWORD on the API when those are overridden
# NEXT_PUBLIC_DEMO_MEMBER_PASSWORD=
# NEXT_PUBLIC_DEMO_ADMIN_PASSWORD=

# Optional branding (compiled in at build time; rebuild after changing)
# NEXT_PUBLIC_APP_NAME=NutriLens
# NEXT_PUBLIC_APP_LOGO_URL=/brand/logo.svg
