# Server Configuration
PORT=5000
# REQUIRED in production: long random string that signs login tokens (generate: see HowToSetup.md).
# The API refuses to sign or verify tokens in production without it. If empty in development a
# random secret is used per run (logins reset on restart).
JWT_SECRET=
# Login token lifetime in seconds (default 604800 = 7 days).
JWT_TTL_SECONDS=604800
NODE_ENV=development

# Web origins allowed to call the API directly from the browser (comma-separated), e.g. your Vercel URL.
# Empty: http://localhost:3000 in development, no cross-origin access in production.
CORS_ORIGINS=
# Largest JSON request body, and largest scan / meal photo (data URL length, bytes).
BODY_LIMIT=5mb
MAX_SCAN_IMAGE_BYTES=3145728

# REQUIRED: MongoDB connection string. Every route except /api/health returns 503 without it.
# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/nutrilens?retryWrites=true&w=majority
# Local MongoDB (see HowToSetup.md); use 127.0.0.1, not localhost
MONGODB_URI=mongodb://127.0.0.1:27017/nutrilens

# AI Computer Vision Models (Optional but recommended)
# Read by server/src/services/foodRecognitionService.js (also accepts GOOGLE_AI_API_KEY).
# Google Gemini 1.5 Flash Vision API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=

# Hugging Face Inference Token for Food-101 Vision Model (Get from https://huggingface.co/settings/tokens)
# Read as HUGGINGFACE_API_KEY or HF_TOKEN (either name works).
HF_TOKEN=

# One-click demo logins (demo member + read-only demo admin) and sample members.
# Empty (default): on in development, OFF when NODE_ENV=production. "true" forces it on, "false" off.
# WARNING: do NOT set DEMO_MODE=true on a production server that holds real member data. Anyone can
# open the demo admin; it cannot change anything and sees real members only masked, but it is still
# a public window into the admin panel. Use it only for a showcase deployment with sample data.
DEMO_MODE=
# Required only with NODE_ENV=production and DEMO_MODE=true: set "true" to confirm this database holds
# sample data only (a showcase). Without it the API refuses to start, so the public demo admin can never
# be opened on a production database with real members by accident.
DEMO_SHOWCASE=
# Optional. The one-click buttons use POST /api/auth/demo-login and need no password.
# Set these only if the demo accounts should also accept email + password sign-in; when empty a
# random password is generated on each start. Use long random values, never commit them.
DEMO_MEMBER_PASSWORD=
DEMO_ADMIN_PASSWORD=
