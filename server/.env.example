# Server Configuration
PORT=5000
# Long random string used to sign login tokens (generate: see HowToSetup.md).
# Required in production. If empty in development a random secret is used per run (logins reset on restart).
JWT_SECRET=
NODE_ENV=development

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/nutrilens?retryWrites=true&w=majority
# Local MongoDB (see HowToSetup.md); use 127.0.0.1, not localhost
MONGODB_URI=mongodb://127.0.0.1:27017/nutrilens

# AI Computer Vision Models (Optional but recommended)
# Google Gemini 1.5 Flash Vision API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=

# Hugging Face Inference Token for Food-101 Vision Model (Get from https://huggingface.co/settings/tokens)
HF_TOKEN=

# One-click demo logins (demo member + read-only demo admin) and sample members.
# On by default. Set to false to stop creating and refreshing demo data (existing demo records are kept).
DEMO_MODE=true
# Optional: override the public demo passwords (also set NEXT_PUBLIC_DEMO_MEMBER_PASSWORD /
# NEXT_PUBLIC_DEMO_ADMIN_PASSWORD in web/ so the one-click buttons still work).
DEMO_MEMBER_PASSWORD=
DEMO_ADMIN_PASSWORD=
