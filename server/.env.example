# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/nutrilens?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/nutrilens?retryWrites=true&w=majority

# AI Computer Vision Models (Optional but recommended)
# Google Gemini 1.5 Flash Vision API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=

# Hugging Face Inference Token for Food-101 Vision Model (Get from https://huggingface.co/settings/tokens)
HF_TOKEN=

# Secret used to sign login tokens (required in production). Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Comma-separated frontend origins allowed by CORS (unset = allow any origin)
# Example: https://nutrilens.vercel.app,http://localhost:3000
CORS_ORIGIN=

# Comma-separated emails allowed to add foods to the shared catalog (POST /api/foods)
ADMIN_EMAILS=

# Frontend URL used in password reset emails
APP_URL=http://localhost:3000

# SMTP settings for password reset emails. When SMTP_HOST is unset in development,
# emails are printed to the server console instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=NutriLens <no-reply@example.com>
